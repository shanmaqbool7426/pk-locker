<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Lock overlay (LockService): single code display box — 8 in a row -->
    <style name="CodeBox">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/code_box_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Lock overlay (LockService): hex keypad key (0-9, A-F) -->
    <style name="KeypadKey" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/keypad_key_bg</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
