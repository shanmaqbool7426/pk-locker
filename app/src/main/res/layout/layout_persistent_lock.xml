<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Warning Band -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/warning_border_bg"
            android:paddingHorizontal="40dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="! WARNING !"
                android:textColor="#DC2626"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="DEVICE LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:text="For security reasons, this terminal has been restricted."
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Security Shield Placeholder -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.8"
            android:src="@android:drawable/ic_lock_lock"
            android:tint="#DC2626" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

        <!-- Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/premium_card_bg"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvShopName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="ALI MOBILE SHOP"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvShopPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:alpha="0.5"
                android:text="0300-1234567"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:alpha="0.1"
                android:background="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMI PENDING"
                        android:textColor="#DC2626"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmiAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rs. 2,500"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"
                        android:text="DUE DATE"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDueDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 March"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.7"
                android:background="@drawable/quote_bg"
                android:padding="16dp"
                android:text="&quot;EMI pay karein aur phone unlock karwain&quot;"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Payment Progress Info -->
            <LinearLayout
                android:id="@+id/paymentInfoSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.1"
                    android:background="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.5"
                            android:text="REMAINING BALANCE"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBalanceAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rs. 0"
                            android:textColor="#F59E0B"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.5"
                            android:text="INSTALLMENTS"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInstallmentProgress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0/0 Paid"
                            android:textColor="#10B981"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- WhatsApp Help & Support Button -->
        <LinearLayout
            android:id="@+id/btnWhatsAppSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/whatsapp_button_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_send"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopkeeper se Rabta Karein"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="WhatsApp — +92 306 9829158"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <TextView
            android:id="@+id/tvShowUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0.3"
            android:text="Enter Clearance Code"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Built-in hex keypad — system keyboard cannot attach to lock overlay
             windows (IME flashes open then instantly closes), so code entry uses
             its own 0-9/A-F keypad. Works over the keyguard too. -->
        <LinearLayout
            android:id="@+id/unlockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 8-digit code display (filled by LockService) -->
            <LinearLayout
                android:id="@+id/codeBoxesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
                <TextView style="@style/CodeBox" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCodeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#DC2626"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <GridLayout
                android:id="@+id/keypadGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:columnCount="4">

                <Button style="@style/KeypadKey" android:tag="1" android:text="1" />
                <Button style="@style/KeypadKey" android:tag="2" android:text="2" />
                <Button style="@style/KeypadKey" android:tag="3" android:text="3" />
                <Button style="@style/KeypadKey" android:tag="4" android:text="4" />
                <Button style="@style/KeypadKey" android:tag="5" android:text="5" />
                <Button style="@style/KeypadKey" android:tag="6" android:text="6" />
                <Button style="@style/KeypadKey" android:tag="7" android:text="7" />
                <Button style="@style/KeypadKey" android:tag="8" android:text="8" />
                <Button style="@style/KeypadKey" android:tag="9" android:text="9" />
                <Button style="@style/KeypadKey" android:tag="0" android:text="0" />
                <Button style="@style/KeypadKey" android:tag="A" android:text="A" />
                <Button style="@style/KeypadKey" android:tag="B" android:text="B" />
                <Button style="@style/KeypadKey" android:tag="C" android:text="C" />
                <Button style="@style/KeypadKey" android:tag="D" android:text="D" />
                <Button style="@style/KeypadKey" android:tag="E" android:text="E" />
                <Button style="@style/KeypadKey" android:tag="F" android:text="F" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCodeDelete"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#4A4A4A"
                    android:text="⌫ DELETE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSubmitUnlock"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2E7D32"
                    android:text="VERIFY CODE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
